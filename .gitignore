# ── IDE / 构建缓存 ──
*.iml
.gradle/
.kotlin/
/.idea/
**/.idea/
.DS_Store
build/
**/build/
/captures
.externalNativeBuild
.cxx
**/.cxx
local.properties

# ── 应用构建产物 ──
/app/build/
*.apk
wrapper_output.txt

# ── 预编译动态库（由 build_llamacpp.ps1 / build_mnn.ps1 重新生成）──
app/src/main/jniLibs/

# ── 大模型权重 / 中间产物（GB 级，不入库）──
temp/
mnn_models/

# ── WorkBuddy 内部记录（含本机路径，不公开）──
.workbuddy/

# 第三方库构建产物（MNN / llama.cpp 编译输出，含 .so，不入库）
**/build-*/

# 注：llama.cpp/ 与 MNN/ 为 vendored 第三方源码，按需要整库提交。
